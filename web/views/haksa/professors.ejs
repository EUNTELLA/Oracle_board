<div class="my-5">
    <h1 class="text-center">교수 관리</h1>
    <div class="text-end mb-3">
        <a class="btn btn-primary px-5" href="/haksa/pro/insert">교수 등록</a>
    </div>
    <table id="tbl" class="table table-striped table-hover"></table>
    <script id="temp" type="text/x-handlebars-template">
        <tbody>
            {{#each .}}
            <tr>
                <td>{{PCODE}}</td><td>{{PNAME}}</td><td>{{DEPT}}</td>
                <td>{{FDATE}}</td><td>{{FSALARY}}</td>
                <td class="text-end"><button class="btn btn-outline-danger btn-sm delete" data-pcode="{{PCODE}}">삭제</button></td>
            </tr>
            {{/each}}
        </tbody>
    </script>
</div>
<script>
    getList();
    //삭제 버튼을 클릭한 경우
    $("#tbl").on("click", ".delete", function () {
        const pcode = $(this).data("pcode");

        if (confirm(`${pcode}번 교수를 삭제하실래요?`)) {
            //삭제 REST API 호출
            $.ajax({
                type: "post",
                url: `/haksa/pro/delete`,
                data: { pcode: pcode },
                success: function () {
                    getList();
                    alert(`${pcode}번 교수를 삭제했습니다.`);
                },
                error: function () {
                    alert(`${pcode}번 교수 삭제 실패했습니다.`);
                }
            });
        }
    });

    function getList() {
        $.ajax({
            type: "get",
            url: "/haksa/pro/list.json",
            success: function (data) {
                console.log(data);
                const temp = Handlebars.compile($("#temp").html());
                $("#tbl").html(temp(data));
            }
        });

    }
</script>