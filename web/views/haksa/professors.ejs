<div class="my-5">
    <h1 class="text-center">교수 관리</h1>
    <div class="text-end mb-3">
        <a class="btn btn-primary px-5" href="/haksa/pro/insert">교수 등록</a>
    </div>
    <table id="tbl" class="table table-striped table-hover"></table>
    <script id="temp" type="x-handlebars-template">
        <tbody>
            {{#each .}}
            <tr>
                <td>{{PCODE}}</td>
                <td>{{PNAME}}</td>
                <td>{{DEPT}}</td>
                <td>{{FDATE}}</td>
                <td>{{TITLE}}</td>
                <td>{{FSALARY}}</td>
                <td><button class="btn btn-outline-danger btn-sm delete" pcode="{{PCODE}}">삭제</button></td>
            </tr>
            {{/each}}
        </tbody>
    </script>
</div>
<script>
    getList();
    //삭제 버튼
    $("#tbl").on("click", ".delete", function () {
        const pcode = $(this).data("pcode");
        if (confirm(`${pcode}번 교수를 삭제하실래요?`)) {
            $.ajax({
                type: "post",
                url: `/haksa/pro/delete`,
                data: { pcode: pcode },
                success: function () {
                    alert(`${pcode}번 교수를 삭제했습니다.`);
                    location.href = "/haksa/pro";
                }
            });
        }
    });

    function getList() {
        $.ajax({
            type: "get",
            url: "/haksa/pro/list.json",
            success: function (data) {
                console.log(data);
                const temp = Handlebars.compile($("#temp").html());
                $("#tbl").html(temp(data));
            }
        });

    }
</script>