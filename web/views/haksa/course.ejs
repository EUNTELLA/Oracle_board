<div class="my-5">
    <h1 class="text-center">강좌관리</h1>
    <table id="tbl_courses" class="table table-striped table-hover mt-4"></table>

    <script id="temp_courses" type="text/x-handlebars-template">
        <thead>
            <tr>
                <td>강좌코드</td>
                <td>강좌명</td>
                <td>시수</td>
                <td>강의실</td>
                <td>담당교수</td>
                <td>정원</td>
                <td>수강인원</td>
            </tr>
        </thead>
        <tbody>
            {{#each .}}
            <tr>
                <td>{{LCODE}}</td>
                <td>{{LNAME}}</td>
                <td>{{HOURS}}</td>
                <td>{{ROOM}}</td>
                <td>{{PNAME}}({{INSTRUCTOR}})</td>
                <td>{{CAPACITY}}</td>
                <td>{{PERSONS}}</td>
            </tr>
            {{/each}}
        </tbody>
    </script>
</div>

<script>
    getCourses();

    function getCourses() {
        $.ajax({
            type: "get",
            url: "/haksa/cou/list.json",
            success: function (data) {
                const temp = Handlebars.compile($("#temp_courses").html());
                $("#tbl_courses").html(temp(data));
            },
            error: function () {
                alert("강좌 목록을 불러오지 못했습니다.");
            }
        });
    }
</script>
