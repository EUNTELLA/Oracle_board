    const scode = sessionStorage.getItem("scode");
    const sname = sessionStorage.getItem("sname");
    if (!scode) {
        $(".login").show();
        $(".logout").hide();
    } else {
        $(".login").hide();
        $(".logout").show();
        $(".sname").html(`${sname}(${scode})`);
    }
    $(".logout-btn").on("click", function (e) {
        e.preventDefault();
        if (confirm("정말로 로그아웃 하시겠습니까?")) {
            sessionStorage.clear();
            location.href = "/";
        }
    });


</script>