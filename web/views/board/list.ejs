<div class="my-5">
    <h1 class="text-center mb-5">게시글</h1>
    <table id="tbl" class="table table-striped table-hover"></table>
    <script id="temp" type="text/x-handlebars-template">
    <tbody>
        {{#each .}}
        <tr>
            <td>{{ID}}</td>
            <td>{{TITLE}}</td>
            <td>{{SNAME}}({{WRITER}})</td>
            <td>{{FMT_DATE}}</td>
        </tr>
        {{/each}}
    </tbody>
</script>
    <div class="text-center">
        <button class="btn btn-primary btn-sm px-3" id="prev">이전</button>
        <span id="page" class="mx-3"></span>
        <button class="btn btn-primary btn-sm px-3" id="next">다음</button>
    </div>
</div>

<script>
    let page = 1;
    const size = 10;
    let total = 0;


    getList();

    function getList() {
        $.ajax({
            type: "get",
            url: "/board/list.json",
            data: { page, size },
            success: function (data) {
                console.log(data);
                total = data.total;
                const temp = Handlebars.compile($("#temp").html());
                // 출력은 tbl에 html로 출력
                $("#tbl").html(temp(data.list));
                $("#page").html(`${page} / ${Math.ceil(total / size) || 1}`);

            }
        });
    }

    $("#prev").on("click", function () {
        if (page > 1) {
            page--;
            getList();
        }
    });

    $("#next").on("click", function () {
        if (page < Math.ceil(total / size)) {
            page++;
            getList();
        }
    });
</script>
