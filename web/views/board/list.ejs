<div class="my-5">
    <h1 class="text-center mb-5">게시글</h1>
    <div>
        <form name="frm" class="input-group">
            <input name="word" class="form-control" placeholder="제목 또는 내용입력">
            <button class="btn btn-primary">검색</button>
        </form>
    </div>
    <table id="tbl" class="table table-striped table-hover"></table>
    <div class="text-center">
        <button class="btn btn-primary btn-sm px-3" id="prev">이전</button>
        <span id="page"></span>
        <button class="btn btn-primary btn-sm px-3" id="next">다음</button>
    </div>

</div>
<script id="temp" type="text/x-handlebars-template">
        <thead>
            <tr>
                <td>번호</td><td>제목</td><td>글쓴이</td><td>날짜</td>
            </tr>
        </thead>
        <tbody>
            {{#each .}}
        <tr>
            <td>{{ID}}</td><td>{{TITLE}}</td><td>{{SNAME}}</td><td>{{FMT_DATE}}</td>
        </tr>
        {{/each}}
    </tbody>
</script>

<script>
    let page = 1;
    const size = 5;
    let word = "";
    getList();

    $("form[name='frm']").on("submit", function (e) {
        e.preventDefault();
        page = 1;
        word = $(this).find("input").val();
        getList();
    });

    $("#next").on("click", function () {
        page++;
        getList();
    });
    $("#prev").on("click", function () {
        page--;
        getList();
    });

    function getList() {
        $.ajax({
            type: "get",
            url: "/board/list.json",
            data: { page, size, word },
            success: function (data) {
                console.log(data);
                const temp = Handlebars.compile($("#temp").html());
                $("#tbl").html(temp(data.list));

                const last = Math.ceil(data.count / size);
                $("#page").html(`${page}/${last}`);
                $("#prev").prop("disabled", page <= 1);
                $("#next").prop("disabled", page >= last);

            }
        });
    }

</script>
